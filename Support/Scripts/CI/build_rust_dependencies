## Usage
## ./Support/Scripts/CI/build_rust_dependencies [--clean-build]

set -eu
set -o pipefail

SOURCE_DIR="${BASH_SOURCE[0]%/*}"

function print_usage {
  cat <<EOF
Usage: ${0##*/} [options]

Builds the libpact_ffi.a binaries (arm64) for iOS, iOS Simulator, and Darwin.

Options:
  --clean-build   Run 'cargo clean' in the pact-reference submodule before building
  -h, --help      Show this help message and exit
EOF
}

########################
#
# Pre-requisites:
# 	1. ``libpact_ffi.version`` file exists in the ${WORKSPACE} folder.
#
#######################

WORKSPACE="${GITHUB_WORKSPACE:-$PWD}"
LIBPACT_FFI_DIR="${WORKSPACE}/pact-reference/rust/pact_ffi"
LIBPACT_FFI_VERSION=$(awk 'NR==1 {print; exit}' libpact_ffi.version)
LOGS_DIR="${WORKSPACE}/.build"
LIBPACT_RUST_DIR="${WORKSPACE}/pact-reference/rust"

# "import"
source "$SOURCE_DIR/../utils.sh"
source "$SOURCE_DIR/../Config/rust_config.sh"

#######################
# Pre-requisite
#######################

# Check whether this script is being run in the right folder
if [ ! -d "$PWD/PactSwiftMockServer.xcodeproj" ]
then
	echo "🚨 Run this from the same folder where your 'PactSwiftMockServer.xcodeproj' lives."
	echo "⚠️ You are runing it in $PWD"
	exit 1
fi

# Check Tooling is available
echo "👮‍♀️  Checking if Rust is installed..."
if which cargo >/dev/null; then
	echo "👍 cargo installed"
elif command -v ~/.cargo/bin/cargo &> /dev/null; then
	echo "👍 cargo installed in ~/.cargo/bin/"
else
	echo "🚨 Rust/Cargo not installed"
	echo -e "error: 'cargo' is a required dependency.\nInstall Rust using either homebrew or follow instructions at https://www.rust-lang.org/tools/install"
 	exit 1
fi

function log_build_environment {
  mkdir -p "$LOGS_DIR"
  local output_file="$1"
  {
    echo "-------------------------------------"
    echo "🔧 Build environment:"
    echo "-------------------------------------"
    echo "  rustc: $(rustc --version)"
    echo
    echo "  clang: $(clang --version)"
    echo
    echo "  cmake: $(cmake --version)"
    echo
    echo "  ld: $(ld -v)"
    echo
    echo "  SDK Version: $(xcrun --sdk macosx --show-sdk-path)"
    echo
    echo "  lipo: $(xcrun --find lipo)"
    echo
    echo "  Rust targets:"
    rustup target list | sed 's/^/\t/'
    echo
    echo "-------------------------------------"
  } >> "$output_file"
}

##############################################
# Vendored Lua
#
# pact_ffi depends on pact_plugin_driver -> mlua -> mlua-sys, and mlua-sys
# compiles Lua from source into its own 'liblua5.4.a', then asks Cargo to link
# it via 'cargo:rustc-link-lib=static=lua5.4'. Cargo only honours that directive
# when it links a final binary; a '--crate-type staticlib' archive holds only
# the objects of this crate graph, so every '_lua*'/'_luaopen_*' symbol is left
# undefined and the consuming Xcode target dies with
# "ld: symbol(s) not found for architecture arm64".
#
# onig_sys needs no such treatment: it compiles its C directly into the crate's
# own objects instead of handing Cargo a prebuilt archive.
#
# So the two archives have to be merged by hand, per target triple.
##############################################

# Echo the path to the most recently built liblua5.4.a for a target triple,
# or an empty string when there is none.
function find_lua_archive {
  local target="$1"
  local build_dir="$LIBPACT_RUST_DIR/target/$target/release/build"
  local newest=""
  local candidate

  # The build directory carries a cargo hash that changes between builds, and
  # stale hashes are left behind, so glob and keep the newest match.
  for candidate in $(find "$build_dir" -type f -name 'liblua5.4.a' -path '*mlua-sys*' 2>/dev/null); do
    if [ -z "$newest" ] || [ "$candidate" -nt "$newest" ]; then
      newest="$candidate"
    fi
  done

  echo "$newest"
}

# Merge a target's libpact_ffi.a with its vendored liblua5.4.a, writing the
# single self-contained archive to $2.
function install_libpact_ffi {
  local target="$1"
  local destination="$2"
  local ffi_lib="$LIBPACT_RUST_DIR/target/$target/release/libpact_ffi.a"
  local lua_lib

  if [ ! -f "$ffi_lib" ]; then
    die "'$ffi_lib' not found — the cargo build for $target did not produce a static library."
  fi

  lua_lib="$(find_lua_archive "$target")"
  if [ -z "$lua_lib" ]; then
    die "No 'liblua5.4.a' found for $target under $LIBPACT_RUST_DIR/target/$target/release/build.
  mlua-sys builds Lua into a separate archive that has to be merged into libpact_ffi.a,
  otherwise linking PactSwiftMockServer fails on undefined '_lua*' symbols."
  fi

  # libtool warns about the (harmless) objects in libpact_ffi.a that carry no
  # symbols; stderr is left alone so real failures stay visible.
  executeCommand "xcrun libtool -static -o \"$destination\" \"$ffi_lib\" \"$lua_lib\""

  # A merge that silently dropped the Lua objects would only surface much later,
  # as a link failure in Xcode, so assert one symbol is really there.
  if ! nm -g "$destination" 2>/dev/null | grep -q 'T _lua_yieldk$'; then
    die "'$destination' still has no Lua symbols after merging '$lua_lib'."
  fi
}

function log_binary_validation {
  mkdir -p "$LOGS_DIR"
  local output_file="$1"
  {
    echo "-------------------------------------"
    echo "🕵️‍♀️ Binary validation"
    echo "-------------------------------------"
    # echo "  iOS Device:"
    # lipo -info "$WORKSPACE"/Resources/iOS-device/libpact_ffi.a
    # echo
    echo "  iOS Simulator:"
    lipo -info "$WORKSPACE"/Resources/iOS-simulator/libpact_ffi.a
    echo
    echo "  Darwin:"
    lipo -info "$WORKSPACE"/Resources/darwin/libpact_ffi.a
    echo
    echo "-------------------------------------"
    echo "🧲 Listing symbols in binaries"
    echo "-------------------------------------"
    # echo " iOS Device:"
    # nm -C "$WORKSPACE"/Resources/iOS-device/libpact_ffi.a
    # echo
    echo " iOS Simulator:"
    nm -C "$WORKSPACE"/Resources/iOS-simulator/libpact_ffi.a
    echo
    echo " Darwin:"
    nm -C "$WORKSPACE"/Resources/darwin/libpact_ffi.a
    echo "-------------------------------------"
  } >> "$output_file"
}

# Verify the active Xcode developer directory is set to a full Xcode install.
# Fails (returns non-zero) if xcode-select is unset or points at the
# standalone Command Line Tools, which lack the iOS simulator SDK.
verify_xcode() {
  local dev_dir
  if ! dev_dir="$(xcode-select -p 2>/dev/null)"; then
    echo "verify_xcode: xcode-select developer directory is not set" >&2
    echo "  fix: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" >&2
    return 1
  fi

  case "$dev_dir" in
    *CommandLineTools*)
      echo "verify_xcode: pointing at Command Line Tools ($dev_dir)" >&2
      echo "  the iphonesimulator SDK requires full Xcode" >&2
      echo "  fix: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" >&2
      return 1
      ;;
  esac

  if ! xcrun --sdk iphonesimulator --show-sdk-path >/dev/null 2>&1; then
    echo "verify_xcode: iphonesimulator SDK could not be located ($dev_dir)" >&2
    return 1
  fi

  echo "verify_xcode: OK ($dev_dir)"
  return 0
}

verify_xcode

# Print build environment
log_build_environment "$LOGS_DIR/build_environment.log"

####################################
# Rust codebase prep
####################################

# Update pact-reference submodule
echo "🔃 Updating pact-reference submodule"
executeCommand "git submodule update --remote --recursive"

echo "ℹ️ Changing location to ${LIBPACT_FFI_DIR}"
executeCommand "cd $LIBPACT_FFI_DIR"

echo "ℹ️ Checking out ${LIBPACT_FFI_VERSION}"
executeCommand "git fetch --all --tags"
executeCommand "git checkout tags/$LIBPACT_FFI_VERSION"

###############################
# Setup rust environment
###############################

# Set the rust toolchain (prepare_rust_tools.sh)
# pact-reference/rust/pact_ffi/CMakeLists.txt uses nightly!
rustup_installNightlyToolchain

# Set default rust toolchain for current machine's architecture
rustup_setDefaultToolchain

# Add the required triples for supported architectures
rustup_addTargets

CLEAN_BUILD=false

for arg in "$@"; do
  case "$arg" in
    --clean-build)
      CLEAN_BUILD=true
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      echo "🚨 Unknown argument: $arg"
      print_usage
      exit 1
      ;;
  esac
done

##############################################
# Pin rustls to a single crypto provider
#
# rustls refuses to pick a provider when more than one of its 'ring' and
# 'aws-lc-rs' features is enabled — it panics with "Could not automatically
# determine the process-level CryptoProvider from Rustls crate features". That
# panic poisons a mutex inside pact_ffi, and the next pactffi_free_pact_handle
# unwraps the PoisonError in a nounwind context, which aborts the whole test
# process. It takes out every TLS mock server test.
#
# Both features end up enabled because the workspace mixes reqwest majors:
# pact_matching/pact_models use reqwest 0.12 "rustls-tls-native-roots" (ring),
# while pact_ffi/pact_verifier/pact_consumer use reqwest 0.13 "rustls", whose
# definition is ["__rustls-aws-lc-rs", ...] — so it drags in aws-lc-rs. Cargo
# unions the two and rustls sees both.
#
# pact_mock_server depends on rustls/ring directly and implements the TLS mock
# server, so ring is the provider to keep. reqwest 0.13 exposes
# "rustls-no-provider", which is "rustls" minus the forced backend — switching to
# it leaves ring as the only provider (and drops the aws-lc-sys C build).
#
# This is patched here rather than in the submodule because the checkout above
# resets it on every run. Remove once fixed upstream in pact-reference.
##############################################

function pin_rustls_to_ring {
  local manifests=(
    "pact_ffi/Cargo.toml"
    "pact_verifier/Cargo.toml"
    "pact_consumer/Cargo.toml"
  )
  local manifest

  for manifest in "${manifests[@]}"; do
    local path="$LIBPACT_RUST_DIR/$manifest"

    if [ ! -f "$path" ]; then
      die "'$path' not found — the pact-reference layout changed, so the rustls provider patch needs revisiting."
    fi

    # Only rewrite the reqwest line, and only the exact "rustls" feature entry.
    if grep -q '^reqwest = .*"rustls"' "$path"; then
      executeCommand "sed -i '' 's/^\(reqwest = .*\)\"rustls\"/\1\"rustls-no-provider\"/' \"$path\""
      echo "🔧 Pinned reqwest to 'rustls-no-provider' in $manifest"
    elif grep -q '^reqwest = .*"rustls-no-provider"' "$path"; then
      echo "ℹ️ $manifest already uses 'rustls-no-provider'"
    else
      echo "⚠️ $manifest has no plain reqwest \"rustls\" feature — upstream may have fixed this already."
    fi
  done
}

# Fail the build rather than ship a binary that aborts the moment a TLS mock
# server starts.
function verify_single_rustls_provider {
  local features
  features=$(cd "$LIBPACT_RUST_DIR" && cargo tree --edges no-dev --format "{f}" -p rustls 2>/dev/null | head -1)

  echo "ℹ️ rustls features resolved to: ${features:-<none>}"

  case "$features" in
    *aws-lc-rs*|*aws_lc_rs*)
      die "rustls still has an aws-lc-rs feature enabled alongside ring.
  A TLS mock server will panic and abort the test process.
  Run 'cargo tree --edges no-dev,features -i rustls' in $LIBPACT_RUST_DIR to find what enables it."
      ;;
  esac
}

pin_rustls_to_ring
verify_single_rustls_provider

##############################################
# Optional clean build
##############################################

if [ "$CLEAN_BUILD" = true ]; then
  echo "🧹 --clean-build passed — cleaning Rust target folder in submodule"
  executeCommand "(cd $LIBPACT_RUST_DIR && cargo clean)"
fi

##############################################
# Build libpact_ffi binaries (arm64 only)
#
# Deployment-target vars are scoped PER build. IPHONEOS_DEPLOYMENT_TARGET must
# NOT be in the environment during the darwin build: ring 0.16.20 compiles its
# aarch64 asm via cc, and a stray IPHONEOS_DEPLOYMENT_TARGET tags that object as
# iOS, which then fails to link into the macOS dylib.
##############################################

echo "🏗 Building libpact_ffi.a for arm64 iOS Simulator"
executeCommand "IPHONEOS_DEPLOYMENT_TARGET=15.0 cargo build --target aarch64-apple-ios-sim --release"

echo "🏗 Building libpact_ffi.a for arm64 iOS device"
executeCommand "IPHONEOS_DEPLOYMENT_TARGET=15.0 cargo build --target aarch64-apple-ios --release"

echo "🏗 Building libpact_ffi.a for arm64 Darwin"
executeCommand "MACOSX_DEPLOYMENT_TARGET=14.0 cargo build --target aarch64-apple-darwin --release"

echo -e "✅ ${GREEN}libpact_ffi.a binaries built$NOCOLOR"

echo "🏗 Building pact_ffi.h..."
executeCommand "mkdir -p build && cd build"

executeCommand "cmake .. && cmake --build ."
executeCommand "cbindgen .. -o ../include/pact_ffi.h"

executeCommand "cd .."

#######################
# Pact Mock Server
#######################

# Copy the compiled binaries into PactSwiftMockServer project, merging each one
# with its vendored liblua5.4.a on the way (see "Vendored Lua" above).
echo "🏗 Copying binaries from ${LIBPACT_RUST_DIR}/target to ${WORKSPACE}/Resources"

# Binary for an iOS device
echo "🚚 Copying arm64-ios (iOS device) binary..."
install_libpact_ffi "$TARGET_ARM64_IOS" "$WORKSPACE/Resources/iOS-device/libpact_ffi.a"
echo -e "${GREEN}👍  Copied arm64-ios binary.$NOCOLOR"
echo

# Binary for iOS Simulator
echo "🚚 Copying arm64 binary for iOS Simulator..."
install_libpact_ffi "$TARGET_ARM64_IOS_SIM" "$WORKSPACE/Resources/iOS-simulator/libpact_ffi.a"
echo -e "${GREEN}👍 Copied arm64-ios-sim binary.$NOCOLOR"
echo

# Binary for Darwin
echo "🚚 Copying arm64-darwin binary..."
install_libpact_ffi "$TARGET_ARM64_DARWIN" "$WORKSPACE/Resources/darwin/libpact_ffi.a"
echo -e "👍 ${GREEN}Copied darwin and arm64-darwin fattie.$NOCOLOR"
echo

echo "🏗 Copying pact_ffi.h from ${PWD}/include to ${WORKSPACE}/Sources"
executeCommand "cp include/pact_ffi.h ${WORKSPACE}/Sources"

# Validate the binaries
# log_binary_validation "$LOGS_DIR/binary_validation.log"

#######################
# Cleanup
#######################

echo -e "📦 ${GREEN}libpact_ffi$NOCOLOR binaries built!"
